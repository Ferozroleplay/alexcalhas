// Banco Hostinger — espelho do sistema Alex (dump + app PHP)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Inventario {
  id              Int     @id @default(autoincrement())
  status          String  @db.VarChar(50)
  nome            String  @db.VarChar(120)
  telefone        String  @db.VarChar(50)
  cpfCnpj         String? @map("cpf-cnpj") @db.VarChar(50)
  endereco        String  @db.VarChar(180)
  bairro          String  @db.VarChar(80)
  numero          String  @db.VarChar(50)
  cep             String  @db.VarChar(50)
  dataVisita      String  @map("data-visita") @db.VarChar(50)
  horaVisita      String  @map("hora-visita") @db.VarChar(50)
  observacao      String? @db.LongText
  funcionario     Int?
  valor           Decimal @default(0.00) @db.Decimal(10, 2)
  descontoPercent Decimal @default(0.00) @map("desconto_percent") @db.Decimal(5, 2)
  formaPagamento  String? @map("forma_pagamento") @db.VarChar(20)
  dataMontagem    String? @map("data-montagem") @db.VarChar(50)
  orcamento       String? @db.LongText

  @@map("inventario")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  thumb        String   @db.VarChar(255)
  nome         String   @db.VarChar(255)
  usuario      String   @db.VarChar(255)
  senha        String   @db.LongText
  email        String   @db.VarChar(255)
  nivel        String   @db.VarChar(255)
  valorDiario  Decimal  @default(0.00) @map("valor_diario") @db.Decimal(10, 2)
  fornecedorId Int?     @map("fornecedor_id")

  @@map("usuarios")
}

model ProdutoSite {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(120)
  descricao String?  @db.VarChar(500)
  ativo     Int      @default(1) @db.TinyInt
  ordem     Int      @default(0)
  criadoEm  DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")
  fotos     ProdutoFoto[]

  @@map("produtos_site")
}

model ProdutoFoto {
  id        Int      @id @default(autoincrement())
  produtoId Int      @map("produto_id")
  arquivo   String   @db.VarChar(255)
  legenda   String?  @db.VarChar(255)
  ehCapa    Int      @default(0) @map("eh_capa") @db.TinyInt
  ordem     Int      @default(0)
  criadoEm  DateTime @default(now()) @map("criado_em")
  produto   ProdutoSite @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@map("produto_fotos")
}

model ParceiroSite {
  id           Int      @id @default(autoincrement())
  nome         String   @db.VarChar(120)
  logo         String?  @db.VarChar(255)
  whatsapp     String?  @db.VarChar(30)
  ativo        Int      @default(1) @db.TinyInt
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  @@map("parceiros_site")
}

model Material {
  id                Int      @id @default(autoincrement())
  material          String?  @db.VarChar(255)
  valorCusto        Decimal  @default(0.00) @map("valor_custo") @db.Decimal(10, 2)
  valor             Decimal  @default(0.00) @db.Decimal(10, 2)
  fornecedorId      Int?     @map("fornecedor_id")
  visivelFornecedor Int      @default(0) @map("visivel_fornecedor") @db.TinyInt
  valorFornecedor   Decimal  @default(0.00) @map("valor_fornecedor") @db.Decimal(10, 2)
  codigo            String?  @db.VarChar(40)
  descricaoNfe      String?  @map("descricao_nfe") @db.VarChar(255)
  unidade           String   @default("M") @db.VarChar(10)
  departamento      String?  @db.VarChar(80)
  subdepartamento   String?  @db.VarChar(80)
  marca             String?  @db.VarChar(80)
  tipoMaterial      String?  @map("tipo_material") @db.VarChar(80)
  referencia        String?  @db.VarChar(80)
  caracteristica    String?  @db.VarChar(120)
  situacao          String   @default("liberado") @db.VarChar(40)
  servico           Int      @default(0) @db.TinyInt
  situacaoTributaria String? @map("situacao_tributaria") @db.VarChar(80)
  ncm               String?  @db.VarChar(20)
  ean               String?  @db.VarChar(40)
  estoqueMinimo     Decimal  @default(0.00) @map("estoque_minimo") @db.Decimal(12, 2)
  capacidadeTotal   Decimal  @default(0.00) @map("capacidade_total") @db.Decimal(12, 2)
  estoqueNegativo   Int      @default(0) @map("estoque_negativo") @db.TinyInt
  fator             Decimal  @default(0.0000) @db.Decimal(12, 4)
  tipoFator         String   @default("multiplicacao") @map("tipo_fator") @db.VarChar(20)
  chapaMm           String?  @map("chapa_mm") @db.VarChar(10)
  corteCm           Decimal  @default(0.00) @map("corte_cm") @db.Decimal(10, 2)
  custoMercado      Decimal  @default(0.00) @map("custo_mercado") @db.Decimal(10, 2)
  custoFormacao     Decimal  @default(0.00) @map("custo_formacao") @db.Decimal(10, 2)
  margemDesejada    Decimal  @default(0.00) @map("margem_desejada") @db.Decimal(8, 2)
  margemAplicada    Decimal  @default(0.00) @map("margem_aplicada") @db.Decimal(8, 2)
  percComissao      Decimal  @default(0.00) @map("perc_comissao") @db.Decimal(8, 2)
  saldoLoja         Decimal  @default(0.00) @map("saldo_loja") @db.Decimal(12, 2)
  saldoGeral        Decimal  @default(0.00) @map("saldo_geral") @db.Decimal(12, 2)
  custoLoja         Decimal  @default(0.00) @map("custo_loja") @db.Decimal(10, 2)
  localizacao       String?  @db.VarChar(120)
  localMapa         String?  @map("local_mapa") @db.VarChar(120)
  coluna            String?  @db.VarChar(40)
  prateleira        String?  @db.VarChar(40)
  box               String?  @db.VarChar(40)

  @@map("materiais")
}

model Fornecedor {
  id                Int      @id @default(autoincrement())
  razaoSocial       String   @map("razao_social") @db.VarChar(255)
  nomeFantasia      String?  @map("nome_fantasia") @db.VarChar(255)
  cnpj              String   @db.VarChar(18)
  inscricaoEstadual String?  @map("inscricao_estadual") @db.VarChar(50)
  email             String?  @db.VarChar(255)
  telefone          String?  @db.VarChar(50)
  contatoNome       String?  @map("contato_nome") @db.VarChar(255)
  cep               String?  @db.VarChar(10)
  endereco          String?  @db.VarChar(255)
  numero            String?  @db.VarChar(20)
  complemento       String?  @db.VarChar(100)
  bairro            String?  @db.VarChar(100)
  cidade            String?  @db.VarChar(100)
  uf                String?  @db.Char(2)
  observacao        String?  @db.Text
  criadoEm          DateTime @default(now()) @map("criado_em")
  atualizadoEm      DateTime @default(now()) @updatedAt @map("atualizado_em")

  @@map("fornecedores")
}

model AdminLog {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  nivel        String   @default("info") @db.VarChar(20)
  mensagem     String   @db.VarChar(500)
  comoResolver String?  @map("como_resolver") @db.Text
  contexto     String?  @db.Text
  pagina       String?  @db.VarChar(500)
  usuarioId    Int?     @map("usuario_id") @db.UnsignedInt
  usuarioNome  String?  @map("usuario_nome") @db.VarChar(255)
  ip           String?  @db.VarChar(45)
  criadoEm     DateTime @default(now()) @map("criado_em")

  @@index([nivel])
  @@index([criadoEm])
  @@map("admin_logs")
}

model Despesa {
  id             Int      @id @default(autoincrement())
  data           DateTime @db.Date
  descricao      String   @db.VarChar(255)
  categoria      String   @db.VarChar(80)
  valor          Decimal  @db.Decimal(10, 2)
  formaPagamento String   @map("forma_pagamento") @db.VarChar(20)
  observacao     String?  @db.Text
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @default(now()) @updatedAt @map("atualizado_em")

  @@index([data])
  @@index([categoria])
  @@map("despesas")
}

/** Atendente do chat no site (foto, nome e mensagem). Uma linha (id = 1). */
model SiteChat {
  id           Int      @id @default(1)
  nome         String   @db.VarChar(80)
  cargo        String   @db.VarChar(120)
  mensagem     String   @db.VarChar(500)
  foto         String?  @db.VarChar(255)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  @@map("site_chat")
}

/** Status aberto/fechado do caixa por dia — compartilhado entre todos os admins. */
model CaixaDia {
  id           Int      @id @default(autoincrement())
  data         DateTime @unique @db.Date
  status       String   @db.VarChar(20)
  abertoPorId  Int?     @map("aberto_por_id")
  fechadoPorId Int?     @map("fechado_por_id")
  abertoEm     DateTime? @map("aberto_em")
  fechadoEm    DateTime? @map("fechado_em")
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  @@map("caixa_dias")
}
